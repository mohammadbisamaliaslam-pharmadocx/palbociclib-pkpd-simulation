# ==============================================================================
# PALBOCICLIB PK/PD SIMULATION & TDM ANALYSIS
# .gitignore - Version Control Exclusions
# ==============================================================================

# ============================================================================
# R-SPECIFIC FILES
# ============================================================================

# R history and session data
.Rhistory
.Rapp.history
.RData
.RDataTmp
*.Rhistory

# RStudio project files
.Rproj.user/
*.Rproj
.Rprofile

# User-specific R settings
.Ruserdata

# R environment variables
.Renviron

# R markdown cache
*_cache/
/cache/
*.utf8.md
*.knit.md

# knitr temporary files
*_files/

# Shiny apps
rsconnect/

# pkgdown documentation
docs/

# R check output
*.Rcheck/
/*.tar.gz

# ============================================================================
# PROJECT-SPECIFIC OUTPUT FILES (LARGE/TEMPORARY)
# ============================================================================

# Simulation outputs (keep code, exclude raw data dumps)
outputs/*.csv
outputs/*.rds
outputs/*.txt
!outputs/.gitkeep

# Figures and plots (exclude generated, keep code)
outputs/*.png
outputs/*.jpg
outputs/*.pdf
!outputs/.gitkeep

# Intermediate data files
data/*.rds
!data/parameters.rds
!data/.gitkeep

# Analysis results
results/*.csv
results/*.txt
results/*.log
!results/.gitkeep

# ============================================================================
# TEMPORARY & SYSTEM FILES
# ============================================================================

# OS-specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor backups & swap files
*~
*.swp
*.swo
*.swn
*#*#
*.tmp
*.temp

# ============================================================================
# IDE & EDITOR CONFIGURATION
# ============================================================================

# VS Code
.vscode/
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.c9/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
.vim/
*.netrwhist

# Emacs
*~
\#*\#
.\#*

# ============================================================================
# PYTHON-RELATED (IF USED ALONGSIDE R)
# ============================================================================

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# pytest
.pytest_cache/
.coverage
htmlcov/

# ============================================================================
# COMPRESSED & LARGE FILES
# ============================================================================

# Compressed archives
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z
*.rar

# Compressed data
*.csv.gz
*.rds.gz
*.RData.gz

# Large media files
*.mp4
*.avi
*.mov
*.wmv
*.flv
*.mkv
*.webm

# Large plots/publications
*.pdf (if > 5MB)

# ============================================================================
# CREDENTIAL & ENVIRONMENT FILES
# ============================================================================

# Environment variables
.env
.env.local
.env.*.local
.env.production.local

# API keys and secrets
secrets.txt
api_keys.json
credentials.json
.aws/

# Database files
*.db
*.sqlite
*.sqlite3

# ============================================================================
# BUILD & INSTALLATION
# ============================================================================

# Build artifacts
build/
dist/
*.egg-info/
*.egg
*.tar.gz

# Installation
site-packages/
*.so

# ============================================================================
# DOCUMENTATION BUILD FILES
# ============================================================================

# Markdown/documentation builds
docs/_build/
docs/site/
site/
*.md.bak

# ============================================================================
# LOG FILES & DEBUG OUTPUT
# ============================================================================

# Simulation logs
*.log
simulation*.log
error*.log
debug*.log

# Package installation logs
pip-log.txt
pip-delete-this-directory.txt

# ============================================================================
# OPERATING SYSTEM SPECIFIC
# ============================================================================

# Windows
Thumbs.db
*.lnk
$RECYCLE.BIN/

# macOS
.AppleDouble
.LSOverride
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
.directory

# ============================================================================
# GITHUB-SPECIFIC
# ============================================================================

# GitHub Actions artifacts
.github/workflows/artifacts/

# GitHub Pages
.github/pages/

# ============================================================================
# DIRECTORIES TO KEEP (STRUCTURE)
# ============================================================================

# Keep empty directories with .gitkeep
!outputs/.gitkeep
!results/.gitkeep
!data/.gitkeep
!figures/.gitkeep
!src/.gitkeep

# ============================================================================
# EXCEPTIONS (INCLUDE IMPORTANT FILES)
# ============================================================================

# DO INCLUDE these files even if pattern matches:

# Include R scripts (core analysis)
!*.R
!src/*.R

# Include markdown files
!README.md
!*.md

# Include configuration files
!.gitignore
!.gitattributes

# Include project files
!*.yml
!*.yaml

# Include data source documentation
!data/README.md
!data/00_Data_Dictionary.md

# Include paper/publication files
!manuscript/*.tex
!manuscript/*.bib
!manuscript/*.docx

# Include parameter files (keep these!)
!data/parameters.rds
!all_params.rds

# ============================================================================
# NOTES
# ============================================================================
# This .gitignore is configured for:
# - R-based pharmacokinetic/pharmacodynamic simulation
# - Clinical trial analysis
# - Health economic evaluation
# 
# Generated outputs (CSV, PNG) are excluded to reduce repo size
# Source code and documentation are included
# 
# To force-add ignored files: git add -f <filename>
# ==============================================================================
