@article{royer2021,
  title     = {Population Pharmacokinetics of Palbociclib in a Real-World Situation},
  author    = {Royer, B. and Henon, S. and Pottier, A. and Chanson, M. and
               Merlin, J. L. and Montange, D. and Ubezio, E. and Bertaut, A. and
               Ghiringhelli, F. and Nerich, V.},
  journal   = {Pharmaceuticals},
  volume    = {14},
  number    = {3},
  pages     = {181},
  year      = {2021},
  month     = {Feb},
  doi       = {10.3390/ph14030181},
  pmid      = {33668400},
  pmcid     = {PMC7996283},
  url       = {https://pmc.ncbi.nlm.nih.gov/articles/PMC7996283/},
  keywords  = {palbociclib, population pharmacokinetics, therapeutic drug monitoring,
               breast cancer, Monte Carlo simulation},
  abstract  = {Real-world population pharmacokinetics study of 124 cancer patients
               (151 samples). One-compartment model, NONMEM estimation, 500-replicate
               bootstrap validation. Key parameters: CL/F = 58.3 L/h (IIV 31.3\%),
               V/F = 1580 L (IIV 40\%), Ka = 0.187 h^{-1}. CRCL was the only
               significant covariate on CL/F. Model suitable for TDM applications.
               NOTE: PMID corrected from 33808262 (v1.0) to 33668400 (v2.0).}
}

@article{courlet2022,
  title     = {Population Pharmacokinetics of Palbociclib and Its Correlation with
               Neutropenia in Patients with {HR+/HER2--} Metastatic Breast Cancer},
  author    = {Courlet, P. and Rouaud, L. and Grunenwald, T. and Thiebaud, C. and
               Leenhardt, F. and Goutelle, S. and Tod, M.},
  journal   = {Pharmaceutics},
  volume    = {14},
  number    = {7},
  pages     = {1317},
  year      = {2022},
  month     = {Jun},
  doi       = {10.3390/pharmaceutics14071317},
  pmid      = {35890213},
  pmcid     = {PMC9322950},
  url       = {https://pmc.ncbi.nlm.nih.gov/articles/PMC9322950/},
  keywords  = {palbociclib, pharmacokinetics, pharmacodynamics, neutropenia,
               E\_max model, exposure-response, ANC},
  abstract  = {Semi-mechanistic myelosuppression model tracking absolute neutrophil
               count dynamics. Emax model superior to linear (AIC difference = 76).
               EC50 = 40.1 ng/mL (fixed from literature; own estimate 8.8 ng/mL
               was unreliable due to data sparseness). Emax = 0.22 (95\% CI:
               0.19--0.25). Hill coefficient gamma = 0.13 (near-flat curve).
               Model-based simulation at 100 mg predicts G3/4 rate of 29\%.
               NOTE: PMID corrected from 35889580 (v1.0) to 35890213 (v2.0).}
}

