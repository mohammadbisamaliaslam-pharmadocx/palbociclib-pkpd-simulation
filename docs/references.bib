  doi       = {10.1097/FTD.0000000000000972},
  pmid      = {35397465},
  pmcid     = {PMC9032884},
  url       = {https://pmc.ncbi.nlm.nih.gov/articles/PMC9032884/},
  keywords  = {therapeutic drug monitoring, palbociclib, neutropenia,
               Cmin target, dose adjustment, NNT, 5-tier classification},
  abstract  = {Primary TDM study motivating this analysis. Prospective bicentric
               clinical trial (n=58 patients, 1 year follow-up). Five-tier Cmin
               classification system. TDM-guided dosing reduces Grade 3/4
               neutropenia. Number Needed to Treat (NNT) = 6.3. LC-MS/MS assay
               validated. TDM threshold: Cmin >100 ng/mL triggers dose reduction
               to 100 mg. This paper reports NNT and the 5-tier system.
               NOTE: This is distinct from leenhardt2022pharmaceutics (same first
               author, same year, different journal — Pharmaceutics vs TDM).}
}

